{
	"name": "vite-plugin-webfont-dl",
	"version": "3.14.0",
	"description": "Vite plugin for downloading and injecting webfonts",
	"keywords": [
		"vite",
		"vite-plugin",
		"web-font",
		"webfont",
		"webfont-dl",
		"webfont-download",
		"google-fonts",
		"bunny-fonts",
		"fontshare",
		"vue",
		"react"
	],
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist/index.js",
		"dist/index.mjs",
		"dist/index.d.ts",
		"dist/index.d.mts"
	],
	"scripts": {
		"start": "npm run build -- --watch",
		"build": "tsup src/index.ts",
		"lint": "tsc --noEmit && eslint \"src/**/*.ts\" --no-fix",
		"lint:fix": "eslint \"src/**/*.ts\" --fix",
		"test": "vitest"
	},
	"author": "feat. agency <hello@feat.agency>",
	"license": "MIT",
	"dependencies": {
		"axios": "^1",
		"clean-css": "^5",
		"picocolors": "^1"
	},
	"peerDependencies": {
		"vite": "^2 || ^3 || ^4 || ^5 || ^6 || ^7 || ^8"
	},
	"devDependencies": {
		"@eslint/js": "^10",
		"@types/clean-css": "^4",
		"@types/node": "^22",
		"eslint": "^10",
		"globals": "^17",
		"tsup": "^9",
		"typescript": "^6",
		"typescript-eslint": "^8",
		"vite": "^8",
		"vitest": "^5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feat-agency/vite-plugin-webfont-dl.git"
	},
	"bugs": {
		"url": "https://github.com/feat-agency/vite-plugin-webfont-dl/issues"
	},
	"homepage": "https://webfont-dl.feat.agency"
}
